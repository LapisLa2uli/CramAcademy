# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: canonical public URL for email confirmation links (omit locally to use http://localhost:3000).
# On Vercel, set to your deployment URL, e.g. https://cram-academy.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: FastAPI base URL (omit locally to use Next.js /backend-api proxy)
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# --- AI extract: user-local Ollama (browser calls 127.0.0.1, no vision API on your backend) ---
# Set to local_ollama to run extraction in the browser against local Ollama. Requires Ollama
# installed + a vision model (default: ollama pull llava:7b). See README: Ollama CORS for production.
# NEXT_PUBLIC_EXTRACTION_MODE=local_ollama
# NEXT_PUBLIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# HTTPS page (e.g. Vercel) + local Ollama: use nginx TLS proxy — see docs/nginx-ollama-proxy-https.conf
# NEXT_PUBLIC_OLLAMA_BASE_URL=https://127.0.0.1:8443
# NEXT_PUBLIC_OLLAMA_MODEL=llava:7b
# Faster raster defaults (optional overrides):
# NEXT_PUBLIC_OLLAMA_RASTER_DPI=128
# NEXT_PUBLIC_OLLAMA_MAX_EDGE=1280
# NEXT_PUBLIC_OLLAMA_MAX_EDGE_HIGH=2560
# Optional: set true only if your Ollama build supports OpenAI json_schema response_format
# NEXT_PUBLIC_EXTRACTION_USE_JSON_SCHEMA=false
# Vision: `low` uses less RAM/tokens than `high` (default low). Per-request timeout when no job-level signal: NEXT_PUBLIC_OLLAMA_CHAT_TIMEOUT_MS (default 30 min).
# NEXT_PUBLIC_OLLAMA_IMAGE_DETAIL=low
# Parallel pages (default 1; raise only if you have VRAM/CPU headroom)
# NEXT_PUBLIC_OLLAMA_PAGE_CONCURRENCY=1
# Optional: extraction wizard shows page + pipeline step + waiting vs generating (with debug streaming)
# NEXT_PUBLIC_EXTRACTION_DEBUG_UI=true
# NEXT_PUBLIC_EXTRACTION_DEBUG_STREAM=false
