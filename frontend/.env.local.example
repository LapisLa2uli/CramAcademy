# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: canonical public URL for email confirmation links (omit locally to use http://localhost:3000).
# On Vercel, set to your deployment URL, e.g. https://cram-academy.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional: FastAPI base URL (omit locally to use Next.js /backend-api proxy)
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
