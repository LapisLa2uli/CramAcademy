# Copy to backend/.env and fill in values (see README Environment Variables).

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Recommended: Dashboard → Settings → API → JWT Secret (HS256)
SUPABASE_JWT_SECRET=

# AI: 302.ai (default) or Ollama on the same host as FastAPI (not used for browser → local Ollama extraction)
AI_PROVIDER=302ai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.302.ai/v1
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl

# Set false to disable server /extraction/analyze* when using only client-side local Ollama extraction in production
EXTRACTION_ENABLED=true
